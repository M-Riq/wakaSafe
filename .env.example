# WakaSafe — environment variables template.
# Copy this file to apps/mobile/.env.local (never commit real .env files).
# Only EXPO_PUBLIC_* variables are exposed to the client bundle: never put secrets here.

# Data source used by the client composition root. Only "mock" exists until phase 12.
EXPO_PUBLIC_DATA_SOURCE=mock

# OpenStreetMap tile server of the web map. Respect the OSM tile usage policy.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Credit shown on the map (HTML). Change it together with the tile provider.
EXPO_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Simulated network latency of the mock repositories, in milliseconds (0 to disable).
EXPO_PUBLIC_MOCK_LATENCY_MS=300

{
  "expo": {
    "name": "WakaSafe",
    "slug": "wakasafe",
    "scheme": "wakasafe",
    "version": "0.1.0",
    "description": "Application citoyenne de prévention et de sécurité routière (GOSAFE).",
    "platforms": ["android", "web"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "org.gosafe.wakasafe",
      "adaptiveIcon": {
        "backgroundColor": "#EAF2FB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "WakaSafe",
      "shortName": "WakaSafe",
      "lang": "fr",
      "themeColor": "#0B5CAD",
      "backgroundColor": "#F8FAFC"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "WakaSafe utilise vos photos pour votre profil, vos justificatifs et vos signalements.",
          "cameraPermission": "WakaSafe utilise l’appareil photo pour votre profil, vos justificatifs et vos signalements.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WakaSafe utilise votre position pour placer vos signalements sur la carte.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
